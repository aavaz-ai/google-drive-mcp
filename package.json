{
    "name": "@enterpret/google-drive-mcp",
    "version": "0.3.1",
    "description": "Enterpret-managed Google Drive MCP for drive.file-authorized content, based on piotr-agier/google-drive-mcp",
    "license": "MIT",
    "author": "Piotr Agier <piotr.agier@gmail.com>",
    "contributors": [
        "Enterpret"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aavaz-ai/google-drive-mcp.git"
    },
    "bugs": {
        "url": "https://github.com/aavaz-ai/google-drive-mcp/issues"
    },
    "homepage": "https://github.com/aavaz-ai/google-drive-mcp#readme",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "claude",
        "google-drive",
        "google-docs",
        "google-sheets",
        "google-slides",
        "google-workspace",
        "ai",
        "llm",
        "integration",
        "oauth2",
        "file-management",
        "document-automation"
    ],
    "type": "module",
    "exports": {},
    "bin": {
        "google-drive-mcp": "./dist/index.js"
    },
    "files": [
        "dist/",
        "README.md",
        "README_UPSTREAM.md",
        "ENTERPRET.md",
        "CHANGELOG.md",
        "CHANGELOG_ENTERPRET.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.managed-tests.json",
        "build": "shx rm -rf dist && npm run typecheck && node scripts/build.js",
        "start": "node dist/index.js",
        "watch": "node scripts/build.js --watch",
        "prepare": "npm run build",
        "test": "npm run test:upstream && npm run test:managed",
        "test:upstream": "npm run test:build && node scripts/run-upstream-tests.mjs",
        "test:managed": "npm run build && vitest run",
        "test:build": "shx rm -rf .tmp-test && tsc -p tsconfig.test.json && shx cp package.json .tmp-test/ && node scripts/build.js",
        "test:unit": "npm run test:build && MCP_TESTING=1 node --test .tmp-test/test/*.test.js",
        "test:integration": "npm run test:build && MCP_TESTING=1 node --test \".tmp-test/test/integration/**/*.test.js\" \".tmp-test/test/schema/**/*.test.js\"",
        "lint": "npm run typecheck && eslint src/",
        "lint:types": "npm run typecheck",
        "lint:eslint": "eslint src/",
        "check": "npm run lint && npm test && npm run build",
        "smoke:pack": "node scripts/pack-smoke.mjs",
        "smoke:live:fresh": "node scripts/live-fresh-process-smoke.mjs"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.29.0",
        "zod": "^3.25.76"
    },
    "overrides": {
        "@hono/node-server": "^2.0.5",
        "body-parser": "^2.3.0",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@google-cloud/local-auth": "^3.0.1",
        "@types/express": "^5.0.3",
        "@types/node": "^22.9.3",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "esbuild": "^0.25.8",
        "eslint": "^10.8.0",
        "express": "^5.1.0",
        "google-auth-library": "^9.15.0",
        "googleapis": "^144.0.0",
        "jszip": "^3.10.1",
        "open": "^10.2.0",
        "pdf-lib": "^1.17.1",
        "punycode": "^2.3.1",
        "shx": "^0.4.0",
        "typescript": "^5.6.2",
        "uuid": "^11.1.1",
        "vitest": "4.1.10"
    }
}
